# DeepSeek 通过 OpenAI 兼容接口调用
OPENAI_API_KEY=your_deepseek_api_key

# MySQL Checkpointer 按 thread_id 持久化 Agent State 和 messages
MYSQL_CHECKPOINT_URI=mysql://agent_user:agent_password@127.0.0.1:3306/agent_memory

# 默认使用无需外部服务的本地语义索引
EMBEDDING_PROVIDER=local

# 换成有效的 DashScope Key 后，可启用 text-embedding-v4
# EMBEDDING_PROVIDER=dashscope
# DASHSCOPE_API_KEY=your_dashscope_api_key
