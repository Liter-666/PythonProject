# DeepSeek 通过 OpenAI 兼容接口调用
OPENAI_API_KEY=your_deepseek_api_key

# PostgreSQL 同时持久化 Checkpointer、长期 Store 和应用会话登记
POSTGRES_URI=postgresql://root:your_password@127.0.0.1:5432/agent_memory?sslmode=disable

# 限制 Checkpointer 反序列化类型，降低数据库内容被篡改后的代码执行风险
LANGGRAPH_STRICT_MSGPACK=true

# 优先使用 DashScope text-embedding-v4；连接失败时自动切换到本地哈希
EMBEDDING_PROVIDER=dashscope
DASHSCOPE_API_KEY=your_dashscope_api_key

# 如需完全禁止外部 Embedding 调用，可显式改成本地模式
# EMBEDDING_PROVIDER=local
